<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No internet permission, and none will be added: the vault never leaves the phone
         through this app. The alarm empties the clipboard thirty seconds after a copy, should
         the app have been closed in between; the camera is the QR scanner's, asked for the
         first time a code is scanned. The fingerprint sensor opens the vault when Settings says
         so, through the phone's own fingerprint sheet; the app never sees the fingerprint. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <!-- The apps that keep files (Files, a Nextcloud app, Syncthing): the vault lives in one of
             them. Without this, from Android 11 on, the right to a file picked through one of them
             outlives the app's own ability to see that app: an update of Passwords left a vault on
             a server unreachable, "no provider", with its permission still granted. -->
        <intent>
            <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
        </intent>
        <!-- The other apps that act on selected text, for the ⋮ in the selection menu. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- A browser, for an entry's web address. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".AikotobaApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/no_backup"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A KeePass file opened from Files or another app. KeePass files have no type of
                 their own on Android, so they are known by the name's ending. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.kdbx" />
                <data android:pathPattern=".*\\..*\\.kdbx" />
                <data android:pathPattern=".*\\..*\\..*\\.kdbx" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-keepass2" />
            </intent-filter>

            <!-- A sign-in's link to set up a code, pressed in a browser or a message. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="otpauth" />
                <data android:scheme="otpauth-migration" />
            </intent-filter>

            <!-- Shared to it: a link, a picture with a QR code, an export file. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- Opened only through the autofill service's own pending intent. -->
        <activity
            android:name=".autofill.FillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <service
            android:name=".autofill.FillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill" />
        </service>

        <receiver
            android:name=".Clipboard$ClearReceiver"
            android:exported="false" />

    </application>

</manifest>
